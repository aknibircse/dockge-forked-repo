# Node environment (development or production)
NODE_ENV=development

# Server configuration
RACKGE_PORT=5001
RACKGE_HOSTNAME=

# SSL configuration
RACKGE_SSL_KEY=
RACKGE_SSL_CERT=
RACKGE_SSL_KEY_PASSPHRASE=

# Directory paths
RACKGE_STACKS_DIR=./stacks/
RACKGE_DATA_DIR=./data/

# Container configuration
RACKGE_IS_CONTAINER=

# Package management
STORE_PATH=/opt/.pnpm-store

# Timezone
TZ=Asia/Dhaka

# Logging
RACKGE_HIDE_LOG=
SQL_LOG=

# Testing
TEST_BACKEND=
TEST_CHECK_VERSION=

# WebSocket configuration
UPTIME_KUMA_WS_ORIGIN_CHECK=

# Version control
VERSION=
